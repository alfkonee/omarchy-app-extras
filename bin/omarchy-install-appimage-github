#!/bin/bash

# Install an AppImage straight from a GitHub repository's releases and remember
# where it came from, so omarchy-update-appimages can keep it current.
#
# Usage: omarchy-install-appimage-github [owner/repo | github url] [asset-name]

set -euo pipefail

source "$HOME/.local/lib/omarchy/appimage.sh"

command -v jq &>/dev/null || { echo "jq is required."; exit 1; }

INPUT="${1-}"
WANTED_ASSET="${2-}"

if [[ -z $INPUT ]]; then
  echo -e "\e[32mInstall an AppImage from a GitHub repository's releases.\e[0m\n"
  INPUT=$(gum input --prompt "Repo> " --placeholder "owner/repo or https://github.com/owner/repo")
fi

REPO=$(normalize_repo "$INPUT")
[[ $REPO == */* ]] || { echo "Not a GitHub repo: $INPUT"; exit 1; }

echo "Looking up the latest release of $REPO..."
RELEASE=$(latest_release_json "$REPO" || true)

if [[ -z ${RELEASE:-} ]]; then
  echo "No releases found for $REPO (or GitHub rate-limited the request)."
  exit 1
fi

TAG=$(jq -r '.tag_name // empty' <<<"$RELEASE")
PUBLISHED=$(jq -r '.published_at // empty' <<<"$RELEASE")

mapfile -t ASSETS < <(release_appimage_assets <<<"$RELEASE")

if ((${#ASSETS[@]} == 0)); then
  echo "Release $TAG of $REPO ships no .AppImage asset."
  exit 1
fi

SELECTED=""
if [[ -n $WANTED_ASSET ]]; then
  for row in "${ASSETS[@]}"; do
    [[ ${row%%$'\t'*} == "$WANTED_ASSET" ]] && SELECTED=$row && break
  done
  [[ -n $SELECTED ]] || { echo "Release $TAG has no asset named $WANTED_ASSET."; exit 1; }
elif ((${#ASSETS[@]} == 1)); then
  SELECTED=${ASSETS[0]}
else
  CHOICE=$(printf '%s\n' "${ASSETS[@]}" | cut -f1 |
    gum choose --header "Asset from $REPO $TAG" --height 12)
  [[ -n ${CHOICE:-} ]] || { echo "Cancelled."; exit 1; }
  for row in "${ASSETS[@]}"; do
    [[ ${row%%$'\t'*} == "$CHOICE" ]] && SELECTED=$row && break
  done
fi

ASSET_NAME=${SELECTED%%$'\t'*}
ASSET_URL=${SELECTED#*$'\t'}
ASSET_GLOB=$(asset_glob "$ASSET_NAME")

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

echo -e "\nDownloading \e[32m$ASSET_NAME\e[0m ($REPO $TAG)..."
download_asset "$ASSET_URL" "$WORK/$ASSET_NAME"

omarchy-install-appimage "$WORK/$ASSET_NAME" \
  --keep-source \
  --repo "$REPO" \
  --release "$TAG" \
  --asset "$ASSET_NAME" \
  --asset-glob "$ASSET_GLOB" \
  --published "$PUBLISHED"

# Tracking an app is what makes the daily update check worth running.
omarchy-appimage-watch enable --quiet
